---
import '../styles/global.css';
import emblem from '../assets/barber-battle/entre-cortes-logo-ai.png';

const { csrfToken } = Astro.props;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Administración · Batalla de Barberos</title>
  </head>
  <body class="admin-page">
    <a class="skip-link" href="#contenido-admin">Saltar al contenido</a>
    <header class="admin-header">
      <a class="admin-brand" href="/admin">
        <span class="admin-brand__emblem" aria-hidden="true"><img src={emblem.src} alt="" width="1536" height="1024" /></span>
        <span class="admin-brand__copy">
          <span class="admin-brand__presenter">Entre Cortes</span>
          <span class="admin-brand__event">Batalla de Barberos</span>
          <span class="admin-brand__area">Administración</span>
        </span>
      </a>
      <form action="/api/admin/logout" method="post">
        <input type="hidden" name="csrf" value={csrfToken} />
        <button class="admin-logout" type="submit">Cerrar sesión</button>
      </form>
    </header>
    <main id="contenido-admin" class="admin-main"><slot /></main>
  </body>
</html>
