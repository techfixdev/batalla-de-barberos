---
import logo from '../assets/barber-battle/entre-cortes-logo-ai.png';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#070808" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Oswald:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="icon" href="data:," />
    <title>{title}</title>
  </head>
  <body class="public-site">
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Entre Cortes, Batalla de Barberos, inicio">
        <span class="brand-emblem" aria-hidden="true">
          <img src={logo.src} width={logo.width} height={logo.height} alt="" />
        </span>
        <span class="brand-copy">
          <span class="brand-name">ENTRECORTES</span>
          <span class="brand-subtitle">BATALLA DE BARBEROS</span>
        </span>
      </a>
      <nav aria-label="Navegación principal">
        <a href="/" aria-current={path === '/' ? 'page' : undefined}>Inicio</a>
        <a href="/#inscripcion">Inscripción</a>
        <a href="/participacion" aria-current={path === '/participacion' ? 'page' : undefined}>Participación</a>
      </nav>
    </header>
    <main id="contenido">
      <slot />
    </main>
    <footer class="site-footer">
      <p><strong>Batalla de Barberos</strong> · Florencio Varela</p>
      <nav aria-label="Información legal">
        <a href="/participacion">Condiciones de participación</a>
        <a href="/privacidad">Privacidad</a>
      </nav>
    </footer>
    <script>
      const publicSite = document.body;
      const feedbackSelector = 'h1, h2, h3, p, dt, dd, li:not(:has(p)), label, legend, .brand-name, .brand-subtitle, .eyebrow, .section-number, .rule-card__number, .rule-card__duration, .event-place, .form-status, .field-error, .signup-aside > span, a:not(.button), .poster-rule, .phrase-rule, hr';
      const movementLimit = 10;
      let activeTarget: HTMLElement | null = null;
      let activePointerId: number | null = null;
      let startX = 0;
      let startY = 0;

      const clearPress = (pointerId?: number) => {
        if (pointerId !== undefined && pointerId !== activePointerId) return;
        activeTarget?.removeAttribute('data-public-press');
        activeTarget = null;
        activePointerId = null;
      };

      publicSite.addEventListener('pointerdown', (event) => {
        if (event.pointerType === 'mouse' || !event.isPrimary || activePointerId !== null) return;
        if (!(event.target instanceof Element)) return;
        const target = event.target.closest(feedbackSelector);
        if (!(target instanceof HTMLElement) || !publicSite.contains(target)) return;

        activeTarget = target;
        activePointerId = event.pointerId;
        startX = event.clientX;
        startY = event.clientY;
        target.setAttribute('data-public-press', '');
      });

      publicSite.addEventListener('pointermove', (event) => {
        if (event.pointerId !== activePointerId) return;
        if (Math.hypot(event.clientX - startX, event.clientY - startY) > movementLimit) clearPress(event.pointerId);
      });
      publicSite.addEventListener('pointerup', (event) => clearPress(event.pointerId));
      publicSite.addEventListener('pointercancel', (event) => clearPress(event.pointerId));
      publicSite.addEventListener('lostpointercapture', (event) => clearPress(event.pointerId));
      window.addEventListener('blur', () => clearPress());
      window.addEventListener('scroll', () => clearPress(), { passive: true });
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) clearPress();
      });
    </script>
  </body>
</html>
