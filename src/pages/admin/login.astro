---
import GoldShears from '../../components/GoldShears.astro';
import logo from '../../assets/barber-battle/entre-cortes-logo-ai.png';
import nightBackground from '../../assets/barber-battle/varela-night-background.png';
import { getDatabase } from '../../lib/database';
import { isValidAdminPasswordHash } from '../../lib/server/admin/password';
import { hasPreauthConfiguration, issuePreauthProof, serializePreauthCookie } from '../../lib/server/admin/preauth-csrf';
import { createAdminSessionService } from '../../lib/server/admin/session-service';
import '../../styles/global.css';

const secret = import.meta.env.ADMIN_SESSION_SECRET_B64;
const passwordHash = import.meta.env.ADMIN_PASSWORD_HASH;
const production = import.meta.env.PROD;
const securityHeaders = { 'Cache-Control': 'private, no-store', 'Content-Security-Policy': "frame-ancestors 'none'", 'Referrer-Policy': 'same-origin', 'X-Frame-Options': 'DENY' };
for (const [name, value] of Object.entries(securityHeaders)) Astro.response.headers.set(name, value);
const cookieName = production ? '__Host-bdb_admin' : 'bdb_admin';
const cookies = Astro.request.headers.get('cookie')?.split(';').map((item) => item.trim()).filter((item) => item.startsWith(`${cookieName}=`)) ?? [];
let unavailable = !isValidAdminPasswordHash(passwordHash) || !hasPreauthConfiguration(secret);
let preauth: ReturnType<typeof issuePreauthProof> = null;
if (!unavailable) {
  try {
    const session = cookies.length === 1 ? await createAdminSessionService({ database: getDatabase(), sessionSecretB64: secret! }).resolve(cookies[0]!.slice(cookieName.length + 1)) : null;
    if (session) return Astro.redirect('/admin', 303);
    preauth = issuePreauthProof({ sessionSecretB64: secret! });
    if (!preauth) unavailable = true;
    else Astro.response.headers.append('Set-Cookie', serializePreauthCookie(preauth.value, preauth.expiresAt, production));
  } catch { unavailable = true; }
}
if (unavailable) Astro.response.status = 503;
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Administración · Batalla de Barberos</title>
  </head>
  <body class="login-page">
    <a class="skip-link" href="#acceso">Saltar al acceso</a>
    <img class="login-background" src={nightBackground.src} alt="" width="1672" height="941" loading="eager" decoding="async" />
    <div class="login-overlay" aria-hidden="true"></div>
    <main id="acceso" class="login-shell">
      <section class="login-brand" aria-labelledby="event-name">
        <img src={logo.src} alt="Entre Cortes" width="1536" height="1024" />
        <p>Panel protegido</p>
        <p id="event-name" class="login-event-name">Batalla de Barberos</p>
        <div class="login-rule"><GoldShears /></div>
        <p class="login-place">Florencio Varela</p>
      </section>

      <section class="login-panel" aria-labelledby="login-title">
        <p class="login-eyebrow">Administración</p>
        <h1 id="login-title">Acceso administrativo</h1>
        <p class="login-intro">Ingresá con la contraseña autorizada para gestionar las inscripciones.</p>
        {unavailable ? <div class="login-alert" role="alert">
          <strong>Servicio no disponible.</strong>
          <span>El acceso administrativo no está disponible en este momento.</span>
        </div> : <form method="post" action="/api/admin/login">
          <input type="hidden" name="preauth" value={preauth?.value} />
          <label for="password">Contraseña</label>
          <input id="password" name="password" type="password" required autocomplete="current-password" />
          <button type="submit">Ingresar</button>
        </form>}
        <a class="login-back" href="/">← Volver al sitio</a>
      </section>
    </main>
  </body>
</html>

<style>
  .login-page { position: relative; min-height: 100svh; margin: 0; overflow-x: hidden; color: var(--ivory); background: var(--ink); isolation: isolate; }
  .login-background, .login-overlay { position: fixed; z-index: -2; inset: 0; width: 100%; height: 100%; }
  .login-background { max-width: none; object-fit: cover; object-position: center; filter: saturate(.38) brightness(.42) contrast(1.16); }
  .login-overlay { z-index: -1; background: radial-gradient(circle at 26% 40%, rgba(210, 164, 59, .14), transparent 30%), linear-gradient(90deg, rgba(7, 8, 8, .92) 0 36%, rgba(7, 8, 8, .66) 62%, rgba(7, 8, 8, .9)), linear-gradient(180deg, rgba(7, 8, 8, .2), var(--ink)); }
  .login-shell { display: grid; width: min(100% - 2rem, 68rem); min-height: 100svh; grid-template-columns: minmax(0, .9fr) minmax(20rem, 27rem); gap: clamp(2rem, 7vw, 7rem); align-items: center; margin-inline: auto; padding-block: 2rem; }
  .login-brand { min-width: 0; text-align: center; text-transform: uppercase; }
  .login-brand > img { width: min(100%, 25rem); max-height: 17rem; margin-inline: auto; object-fit: contain; filter: brightness(1.08) contrast(1.08); }
  .login-brand > p:first-of-type, .login-eyebrow { margin: 1rem 0 .75rem; color: var(--gold-bright); font-size: .76rem; font-weight: 700; letter-spacing: .25em; text-transform: uppercase; }
  .login-event-name { margin: 0; color: var(--ivory); font: 400 clamp(3.4rem, 7vw, 6.7rem)/.9 var(--display); letter-spacing: -.035em; text-wrap: balance; }
  .login-rule { display: flex; width: min(78%, 22rem); align-items: center; gap: .7rem; margin: 1.3rem auto .75rem; color: var(--gold-bright); }
  .login-rule::before, .login-rule::after { height: 1px; flex: 1; background: linear-gradient(90deg, transparent, var(--gold)); content: ''; }
  .login-rule::after { background: linear-gradient(90deg, var(--gold), transparent); }
  .login-place { margin: 0; color: var(--ivory-soft); font-size: .72rem; font-weight: 600; letter-spacing: .3em; }
  .login-panel { position: relative; padding: clamp(1.5rem, 4vw, 2.5rem); border: 1px solid rgba(224, 187, 97, .55); background: linear-gradient(145deg, rgba(23, 25, 25, .98), rgba(10, 11, 11, .98)); box-shadow: .55rem .55rem 0 rgba(210, 164, 59, .2), 0 1.5rem 5rem rgba(0, 0, 0, .55); }
  .login-panel::before { position: absolute; top: -1px; left: -1px; width: 4.5rem; height: 2px; background: var(--gold-bright); content: ''; }
  .login-eyebrow { margin-top: 0; }
  .login-panel h1 { color: var(--ivory); font-size: clamp(2.6rem, 5vw, 4.1rem); letter-spacing: -.025em; }
  .login-intro { margin: 1rem 0 1.75rem; color: var(--ivory-soft); font-size: 1rem; }
  form { display: grid; gap: .65rem; }
  label { color: var(--ivory); font-size: .82rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  input, button { width: 100%; min-height: 48px; border-radius: 0; }
  input { padding: .75rem .9rem; border: 1px solid #73746f; color: var(--ivory); background: var(--ink-soft); caret-color: var(--gold-bright); }
  input:hover { border-color: var(--ivory-soft); }
  input:focus-visible, button:focus-visible, .login-back:focus-visible { outline: 3px solid var(--gold-bright); outline-offset: 3px; }
  button { margin-top: .55rem; padding: .75rem 1rem; border: 1px solid var(--gold-bright); color: var(--ink); background: var(--gold-bright); font-weight: 700; letter-spacing: .14em; text-transform: uppercase; cursor: pointer; }
  button:hover { background: var(--ivory); border-color: var(--ivory); }
  .login-alert { display: grid; gap: .3rem; margin-top: 1.5rem; padding: 1rem; border-left: 4px solid #ff9182; color: var(--ivory-soft); background: #251615; }
  .login-alert strong { color: var(--ivory); }
  .login-back { display: inline-flex; min-height: 44px; align-items: center; margin-top: 1.5rem; color: var(--ivory-soft); font-size: .86rem; font-weight: 600; letter-spacing: .05em; text-underline-offset: .35rem; }
  .login-back:hover { color: var(--gold-bright); }

  @media (max-width: 760px) {
    .login-shell { grid-template-columns: minmax(0, 1fr); gap: 1.25rem; align-content: center; padding-block: 1.25rem; }
    .login-brand > img { width: min(62vw, 14rem); max-height: 9rem; }
    .login-brand > p:first-of-type { margin: .35rem 0; }
    .login-event-name { font-size: clamp(2.6rem, 13vw, 4rem); }
    .login-rule { margin-block: .7rem .35rem; }
    .login-panel { width: 100%; max-width: 30rem; margin-inline: auto; }
  }

  @media (max-width: 370px) {
    .login-shell { width: min(100% - 1rem, 68rem); }
    .login-panel { padding: 1.2rem; }
    .login-panel h1 { font-size: 2.35rem; }
  }
</style>
