---
import BarberRules from '../components/BarberRules.astro';
import GoldShears from '../components/GoldShears.astro';
import SignupForm from '../components/SignupForm.astro';
import Layout from '../layouts/Layout.astro';
import barbers from '../assets/barber-battle/barbers-foreground.png';
import logo from '../assets/barber-battle/entre-cortes-logo-ai.png';
import nightVideo from '../assets/barber-battle/varela-night-background.mp4';
import nightPoster from '../assets/barber-battle/varela-night-background.png';
---

<Layout title="Batalla de Barberos | Entre Cortes" description="Primera edición de la Batalla de Barberos de Florencio Varela. Inscribite para competir.">
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-stage" aria-hidden="true">
      <video class="hero-background" src={nightVideo} poster={nightPoster.src} muted autoplay loop playsinline preload="metadata" tabindex="-1"></video>
      <div class="hero-atmosphere"></div>
      <div class="center-beam"></div>
      <div class="beam-cut"></div>
      <GoldShears variant="beam" class="beam-scissor" />
      <div class="character-plane character-left"><img src={barbers.src} width={barbers.width} height={barbers.height} alt="" loading="eager" decoding="async" /></div>
      <div class="character-plane character-right"><img src={barbers.src} width={barbers.width} height={barbers.height} alt="" loading="eager" decoding="async" /></div>
      <div class="barber-hit-zone barber-hit-zone--left"></div>
      <div class="barber-hit-zone barber-hit-zone--right"></div>
      <div class="hero-grain"></div>
      <div class="hero-vignette"></div>
    </div>

    <div class="poster-copy">
      <div class="hero-brand-lockup">
        <div class="hero-emblem-slot">
          <img class="hero-emblem" data-hero-shears-origin src={logo.src} width={logo.width} height={logo.height} alt="" />
        </div>
        <h1 id="hero-title">
          <span class="event-presenter">Entre Cortes</span>
          <span class="event-title">Batalla de Barberos</span>
        </h1>
      </div>
      <div class="poster-rule" aria-hidden="true"><GoldShears /></div>
      <p class="event-date"><strong>08</strong><span>de<br />noviembre</span></p>
      <p class="event-place">Florencio Varela</p>
    </div>

    <div class="hero-support">
      <p class="hero-intro">Técnica, identidad y precisión frente a frente. El talento barbero de nuestra ciudad toma el escenario.</p>
      <div class="hero-actions">
        <a class="button button-primary" href="#inscripcion">Quiero competir <span aria-hidden="true">↓</span></a>
        <a class="text-link" href="/participacion">Cómo participar <span aria-hidden="true">↗</span></a>
      </div>
      <dl class="event-facts" aria-label="Datos del evento">
        <div><dt>Edición</dt><dd>Primera</dd></div>
        <div><dt>Fecha</dt><dd>8 de noviembre</dd></div>
        <div><dt>Premio</dt><dd>4 copas</dd></div>
      </dl>
    </div>
  </section>

  <script>
    const hero = document.querySelector<HTMLElement>('.hero');
    const origin = hero?.querySelector<HTMLElement>('[data-hero-shears-origin]');
    const shears = hero?.querySelector<HTMLElement>('.beam-scissor');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    if (hero && origin && shears && !reducedMotion.matches) {
      hero.classList.add('hero-shears-pending');

      const settleAtFinalPosition = () => {
        hero.classList.remove('hero-shears-pending', 'hero-shears-ready');
        shears.style.removeProperty('--hero-origin-x');
        shears.style.removeProperty('--hero-origin-y');
        reducedMotion.removeEventListener('change', handleMotionPreference);
      };
      const handleMotionPreference = (event: MediaQueryListEvent) => {
        if (event.matches) settleAtFinalPosition();
      };
      const revealAtMeasuredOrigin = () => {
        requestAnimationFrame(() => {
          if (reducedMotion.matches) {
            settleAtFinalPosition();
            return;
          }

          const originRect = origin.getBoundingClientRect();
          const shearsRect = shears.getBoundingClientRect();
          if (!originRect.width || !originRect.height || !shearsRect.width || !shearsRect.height) {
            settleAtFinalPosition();
            return;
          }

          const originX = originRect.left + originRect.width / 2;
          const originY = originRect.top + originRect.height / 2;
          const finalX = shearsRect.left + shearsRect.width / 2;
          const finalY = shearsRect.top + shearsRect.height / 2;
          shears.style.setProperty('--hero-origin-x', `${originX - finalX}px`);
          shears.style.setProperty('--hero-origin-y', `${originY - finalY}px`);
          hero.classList.remove('hero-shears-pending');
          hero.classList.add('hero-shears-ready');
          shears.addEventListener('animationend', settleAtFinalPosition, { once: true });
        });
      };

      reducedMotion.addEventListener('change', handleMotionPreference);
      document.fonts.ready.then(revealAtMeasuredOrigin, settleAtFinalPosition);
    }
  </script>

  <section class="manifesto" aria-labelledby="manifesto-title">
    <div>
      <p class="eyebrow">Más que una competencia</p>
      <h2 id="manifesto-title">Acá se viene a dejar <em>marca.</em></h2>
      <span class="phrase-rule" aria-hidden="true"><GoldShears /></span>
    </div>
    <p>Convocamos a quienes viven la barbería con oficio y actitud. No importa si estás dando tus primeros pasos o si ya tenés años detrás del sillón: queremos ver qué hacés cuando empieza a correr el reloj.</p>
  </section>

  <section class="steps" aria-labelledby="steps-title">
    <div class="section-heading">
      <p class="eyebrow">El camino al escenario</p>
      <h2 id="steps-title">Tres pasos. Una silla.</h2>
      <span class="phrase-rule" aria-hidden="true"><GoldShears /></span>
    </div>
    <ol>
      <li><span>01</span><h3>Inscribite</h3><p>Completá el formulario con tus datos y experiencia.</p></li>
      <li><span>02</span><h3>Esperá el contacto</h3><p>El equipo revisará tu inscripción y te contará la dinámica.</p></li>
      <li><span>03</span><h3>Mostrá tu técnica</h3><p>Prepará tus herramientas y tu mejor versión para competir.</p></li>
    </ol>
  </section>

  <BarberRules />

  <section id="inscripcion" class="signup-section" aria-labelledby="signup-title">
    <div class="signup-aside" aria-hidden="true">
      <span>FILO</span><span>PULSO</span><span>ACTITUD</span>
    </div>
    <SignupForm />
  </section>
</Layout>
