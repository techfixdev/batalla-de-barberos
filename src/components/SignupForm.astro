---
import DraftTermsLink from './DraftTermsLink.astro';
import GoldShears from './GoldShears.astro';
import TermsAcceptanceModal from './TermsAcceptanceModal.astro';
import { EXPERIENCE_OPTIONS } from '../lib/barber-signups';

const experienceLabels = {
  estudiante: 'Estoy aprendiendo',
  profesional: 'Trabajo como profesional',
  educador: 'También enseño barbería',
};
---

<form id="signup-form" class="signup-form" novalidate>
  <div class="form-heading">
    <p class="eyebrow">Cupos limitados</p>
    <h2 id="signup-title">Entrá a la batalla</h2>
    <span class="phrase-rule" aria-hidden="true"><GoldShears /></span>
    <p>Dejanos tus datos para guardar tu inscripción. La revisión, la selección y una respuesta posterior de la persona participante son instancias distintas.</p>
  </div>

  <div class="form-grid">
    <div class="field">
      <label for="fullName">Nombre y apellido <span aria-hidden="true">*</span></label>
      <input id="fullName" name="fullName" type="text" autocomplete="name" minlength="3" maxlength="100" required aria-describedby="fullName-error" />
      <span class="field-error" id="fullName-error"></span>
    </div>

    <div class="field">
      <label for="email">Correo electrónico <span aria-hidden="true">*</span></label>
      <input id="email" name="email" type="email" inputmode="email" autocomplete="email" maxlength="160" required aria-describedby="email-error" />
      <span class="field-error" id="email-error"></span>
    </div>

    <div class="field">
      <label for="phone">Teléfono <span aria-hidden="true">*</span></label>
      <input id="phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required aria-describedby="phone-error" />
      <span class="field-error" id="phone-error"></span>
    </div>

    <div class="field">
      <label for="barbershop">Barbería <span class="optional">(opcional)</span></label>
      <input id="barbershop" name="barbershop" type="text" autocomplete="organization" maxlength="120" aria-describedby="barbershop-error" />
      <span class="field-error" id="barbershop-error"></span>
    </div>

    <div class="field field-wide">
      <label for="experience">Experiencia <span aria-hidden="true">*</span></label>
      <select id="experience" name="experience" required aria-describedby="experience-error">
        <option value="">Seleccioná una opción</option>
        {EXPERIENCE_OPTIONS.map((option) => <option value={option}>{experienceLabels[option]}</option>)}
      </select>
      <span class="field-error" id="experience-error"></span>
    </div>
  </div>

  <button class="button button-primary" type="submit">Enviar inscripción <span aria-hidden="true">↗</span></button>
  <p id="form-status" class="form-status" role="status" aria-live="polite"></p>
  <p>Antes del envío vas a poder recorrer las bases completas. Las <DraftTermsLink /> no determinan una selección ni una respuesta de participación.</p>
  <TermsAcceptanceModal />
</form>

<script>
  import { requireElementById } from '../lib/dom-selector';

  const form = requireElementById<HTMLFormElement>('signup-form');
  const status = requireElementById<HTMLParagraphElement>('form-status');
  const trigger = form.querySelector<HTMLButtonElement>(':scope > button[type="submit"]')!;
  const dialog = requireElementById<HTMLDialogElement>('terms-acceptance-dialog');
  const termsBody = requireElementById<HTMLElement>('terms-dialog-body');
  const readStatus = requireElementById<HTMLElement>('terms-read-status');
  const acceptedRules = requireElementById<HTMLInputElement>('acceptedRules');
  const cancelButton = requireElementById<HTMLButtonElement>('terms-cancel');
  const confirmButton = requireElementById<HTMLButtonElement>('terms-confirm');
  const fieldNames = ['fullName', 'email', 'phone', 'barbershop', 'experience', 'acceptedRules'] as const;
  let submissionKey = crypto.randomUUID();
  let inFlight = false;
  let focusAfterClose: HTMLElement | null = null;

  function control(name: typeof fieldNames[number]): HTMLInputElement | HTMLSelectElement {
    const item = form.elements.namedItem(name);
    if (!(item instanceof HTMLInputElement || item instanceof HTMLSelectElement)) throw new Error(`Missing form control: ${name}`);
    return item;
  }

  function clearErrors() {
    for (const name of fieldNames) {
      control(name).removeAttribute('aria-invalid');
      requireElementById<HTMLElement>(`${name}-error`).textContent = '';
    }
  }

  function evaluateReadingGate() {
    if (!dialog.open) return;
    const reachedBottom = termsBody.scrollHeight - termsBody.scrollTop - termsBody.clientHeight <= 2;
    if (!reachedBottom) acceptedRules.checked = false;
    acceptedRules.disabled = inFlight || !reachedBottom;
    confirmButton.disabled = inFlight || !reachedBottom || !acceptedRules.checked;
    readStatus.textContent = reachedBottom
      ? 'Llegaste al final de las bases.'
      : 'Recorré las bases hasta el final para habilitar la confirmación.';
  }

  function resetReadingGate() {
    termsBody.scrollTop = 0;
    acceptedRules.checked = false;
    acceptedRules.disabled = true;
    confirmButton.disabled = true;
    readStatus.textContent = 'Recorré las bases hasta el final para habilitar la confirmación.';
  }

  function closeDialog(nextFocus: HTMLElement | null = trigger) {
    focusAfterClose = nextFocus;
    if (dialog.open) dialog.close();
  }

  function openDialog() {
    resetReadingGate();
    dialog.showModal();
    requestAnimationFrame(() => {
      termsBody.scrollTop = 0;
      evaluateReadingGate();
    });
  }

  async function submitSignup() {
    const reachedBottom = termsBody.scrollHeight - termsBody.scrollTop - termsBody.clientHeight <= 2;
    if (inFlight || acceptedRules.disabled || !acceptedRules.checked || !reachedBottom) return;
    inFlight = true;
    acceptedRules.disabled = true;
    cancelButton.disabled = true;
    confirmButton.disabled = true;
    confirmButton.textContent = 'Enviando…';

    const payload = {
      fullName: control('fullName').value,
      email: control('email').value,
      phone: control('phone').value,
      barbershop: control('barbershop').value,
      experience: control('experience').value,
      acceptedRules: true,
    };

    try {
      const response = await fetch('/api/signups', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Idempotency-Key': submissionKey },
        body: JSON.stringify(payload),
      });
      const result = await response.json() as { message?: string; errors?: Record<string, string> };

      if (!response.ok) {
        let firstInvalid: HTMLElement | null = null;
        if (result.errors) {
          for (const [name, message] of Object.entries(result.errors)) {
            if (!fieldNames.includes(name as typeof fieldNames[number])) continue;
            const input = control(name as typeof fieldNames[number]);
            input.setAttribute('aria-invalid', 'true');
            requireElementById<HTMLElement>(`${name}-error`).textContent = message;
            firstInvalid ??= input;
          }
        }
        status.textContent = result.message ?? 'No pudimos enviar la inscripción.';
        closeDialog(firstInvalid ?? trigger);
        return;
      }

      submissionKey = crypto.randomUUID();
      form.reset();
      status.textContent = 'Guardamos tu inscripción. Intentaremos enviarte un acuse por WhatsApp con el PDF adjunto; si no lo recibís, no invalida la inscripción guardada. La selección la decide más adelante la organización y la respuesta posterior de la persona participante se registra por separado. El acuse no constituye consentimiento legal ni confirma selección o participación.';
      closeDialog();
    } catch {
      status.textContent = 'No hay conexión. Revisá tu red e intentá nuevamente.';
      closeDialog();
    } finally {
      inFlight = false;
      cancelButton.disabled = false;
      confirmButton.textContent = 'Aceptar y enviar';
    }
  }

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    clearErrors();
    status.textContent = '';
    if (!form.checkValidity()) {
      form.reportValidity();
      status.textContent = 'Revisá los campos obligatorios.';
      return;
    }
    openDialog();
  });
  termsBody.addEventListener('scroll', evaluateReadingGate);
  window.addEventListener('resize', evaluateReadingGate);
  acceptedRules.addEventListener('change', () => {
    confirmButton.disabled = inFlight || acceptedRules.disabled || !acceptedRules.checked;
  });
  cancelButton.addEventListener('click', () => { if (!inFlight) closeDialog(); });
  confirmButton.addEventListener('click', submitSignup);
  dialog.addEventListener('cancel', (event) => { if (inFlight) event.preventDefault(); });
  dialog.addEventListener('close', () => {
    resetReadingGate();
    (focusAfterClose ?? trigger).focus();
    focusAfterClose = null;
  });
</script>
