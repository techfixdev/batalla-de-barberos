---
import { Image } from 'astro:assets';
import upperShear from '../assets/barber-battle/gold-shears-upper.png';
import lowerShear from '../assets/barber-battle/gold-shears-lower.png';

interface Props {
  variant?: 'beam' | 'compact';
  class?: string;
}

const { variant = 'compact', class: className } = Astro.props;
---

<span
  class:list={['gold-shears', `gold-shears--${variant}`, className]}
  aria-hidden="true"
  tabindex="-1"
>
  <span class="gold-shears__float">
    <span class="gold-shears__pair">
      <Image class="gold-shears__half gold-shears__half--upper" src={upperShear} alt="" width={1254} height={1254} loading="eager" decoding="async" />
      <Image class="gold-shears__half gold-shears__half--lower" src={lowerShear} alt="" width={1254} height={1254} loading="eager" decoding="async" />
    </span>
  </span>
</span>
