---
import tbhEstudio from '../assets/barber-battle/sponsors/tbh-estudio.jpeg';
import harakiri from '../assets/barber-battle/sponsors/harakiri-barber-studio.jpeg';
import jrEstudio from '../assets/barber-battle/sponsors/jr-estudio-203.jpeg';
import entreCortesStream from '../assets/barber-battle/sponsors/entre-cortes-stream.jpeg';
import giovato from '../assets/barber-battle/sponsors/giovato-estudio.jpeg';

const sponsors = [
  { name: 'TBH Estudio', logo: tbhEstudio },
  { name: 'Harakiri Barber Studio', logo: harakiri },
  { name: 'Jr Estudio 203', logo: jrEstudio },
  { name: 'Entre Cortes Stream', logo: entreCortesStream },
  { name: 'Giovato Estudio', logo: giovato },
];
---

<section class="sponsors" role="region" aria-label="Sponsors del evento" data-sponsors-carousel>
  <header class="sponsors-heading">
    <div>
      <p class="eyebrow">Nos acompañan</p>
      <h2 id="sponsors-title">Sponsors que hacen posible el encuentro.</h2>
    </div>
    <div class="sponsors-controls" aria-label="Controles del carrusel">
      <button type="button" aria-label="Sponsor anterior" data-sponsors-previous disabled>
        <span aria-hidden="true">←</span>
      </button>
      <button type="button" aria-label="Pausar reproducción automática" aria-pressed="false" data-sponsors-autoplay>
        <span aria-hidden="true" data-sponsors-autoplay-icon>Ⅱ</span>
      </button>
      <button type="button" aria-label="Sponsor siguiente" data-sponsors-next>
        <span aria-hidden="true">→</span>
      </button>
    </div>
  </header>

  <ul class="sponsors-track" role="group" aria-label="Logos de sponsors" tabindex="0" data-sponsors-track>
    {sponsors.map((sponsor) => (
      <li class="sponsor-card" data-sponsor-card>
        <figure>
          <div class="sponsor-logo">
            <img
              src={sponsor.logo.src}
              width={sponsor.logo.width}
              height={sponsor.logo.height}
              alt={`Logo de ${sponsor.name}`}
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption>{sponsor.name}</figcaption>
        </figure>
      </li>
    ))}
  </ul>
  <p class="sr-only" aria-live="polite" aria-atomic="true" data-sponsors-status>Sponsor 1 de {sponsors.length}: TBH Estudio</p>
</section>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const autoplayDelay = 3000;

  document.querySelectorAll<HTMLElement>('[data-sponsors-carousel]').forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>('[data-sponsors-track]');
    const cards = Array.from(carousel.querySelectorAll<HTMLElement>('[data-sponsor-card]'));
    const previous = carousel.querySelector<HTMLButtonElement>('[data-sponsors-previous]');
    const next = carousel.querySelector<HTMLButtonElement>('[data-sponsors-next]');
    const autoplay = carousel.querySelector<HTMLButtonElement>('[data-sponsors-autoplay]');
    const autoplayIcon = carousel.querySelector<HTMLElement>('[data-sponsors-autoplay-icon]');
    const status = carousel.querySelector<HTMLElement>('[data-sponsors-status]');
    if (!track || !cards.length || !previous || !next || !autoplay || !autoplayIcon || !status) return;

    const firstCard = cards[0]!;
    const cardLeft = (card: HTMLElement) => card.offsetLeft - firstCard.offsetLeft;
    const nearestIndex = () => cards.reduce((nearest, card, index) => (
      Math.abs(cardLeft(card) - track.scrollLeft) < Math.abs(cardLeft(cards[nearest]!) - track.scrollLeft) ? index : nearest
    ), 0);
    const update = () => {
      const index = nearestIndex();
      const edgeTolerance = Math.max(2, track.clientWidth * .01);
      previous.disabled = track.scrollLeft <= edgeTolerance;
      next.disabled = track.scrollLeft >= track.scrollWidth - track.clientWidth - edgeTolerance;
      status.textContent = `Sponsor ${index + 1} de ${cards.length}: ${cards[index]!.querySelector('figcaption')?.textContent ?? ''}`;
    };
    const goTo = (index: number) => {
      const target = cards[Math.max(0, Math.min(cards.length - 1, index))]!;
      track.scrollTo({ left: cardLeft(target), behavior: reducedMotion.matches ? 'auto' : 'smooth' });
    };

    let userPaused = false;
    let pointerPaused = false;
    let focusPaused = false;
    let autoplayTimer: number | undefined;
    const canAutoplay = () => !reducedMotion.matches && !userPaused && !pointerPaused && !focusPaused && !document.hidden;
    const updateAutoplayControl = () => {
      if (reducedMotion.matches) {
        autoplay.disabled = true;
        autoplay.ariaLabel = 'Reproducción automática desactivada por movimiento reducido';
        autoplay.ariaPressed = 'true';
        autoplayIcon.textContent = '▶';
        return;
      }
      autoplay.disabled = false;
      autoplay.ariaLabel = userPaused ? 'Reanudar reproducción automática' : 'Pausar reproducción automática';
      autoplay.ariaPressed = String(userPaused);
      autoplayIcon.textContent = userPaused ? '▶' : 'Ⅱ';
    };
    const stopAutoplay = () => {
      if (autoplayTimer !== undefined) window.clearInterval(autoplayTimer);
      autoplayTimer = undefined;
    };
    const syncAutoplay = () => {
      stopAutoplay();
      updateAutoplayControl();
      if (!canAutoplay()) return;
      autoplayTimer = window.setInterval(() => {
        const atEnd = track.scrollLeft >= track.scrollWidth - track.clientWidth - 2;
        goTo(atEnd ? 0 : nearestIndex() + 1);
      }, autoplayDelay);
    };
    const navigate = (index: number) => {
      goTo(index);
      syncAutoplay();
    };

    previous.addEventListener('click', () => navigate(nearestIndex() - 1));
    next.addEventListener('click', () => navigate(nearestIndex() + 1));
    autoplay.addEventListener('click', () => {
      userPaused = !userPaused;
      syncAutoplay();
    });
    track.addEventListener('keydown', (event) => {
      switch (event.key) {
        case 'ArrowLeft':
          event.preventDefault();
          navigate(nearestIndex() - 1);
          break;
        case 'ArrowRight':
          event.preventDefault();
          navigate(nearestIndex() + 1);
          break;
        case 'Home':
          event.preventDefault();
          navigate(0);
          break;
        case 'End':
          event.preventDefault();
          navigate(cards.length - 1);
          break;
      }
    });

    carousel.addEventListener('mouseenter', () => {
      pointerPaused = true;
      syncAutoplay();
    });
    carousel.addEventListener('mouseleave', () => {
      pointerPaused = false;
      syncAutoplay();
    });
    carousel.addEventListener('focusin', () => {
      focusPaused = true;
      syncAutoplay();
    });
    carousel.addEventListener('focusout', (event) => {
      if (carousel.contains(event.relatedTarget as Node | null)) return;
      focusPaused = false;
      syncAutoplay();
    });
    document.addEventListener('visibilitychange', syncAutoplay);
    reducedMotion.addEventListener('change', syncAutoplay);

    let scheduled = false;
    track.addEventListener('scroll', () => {
      if (scheduled) return;
      scheduled = true;
      requestAnimationFrame(() => {
        update();
        scheduled = false;
      });
    }, { passive: true });
    window.addEventListener('resize', update, { passive: true });
    update();
    syncAutoplay();
  });
</script>
