---
import terms from '../../content/draft-terms/draft-2026-09-v2.json';
---

<section class="barber-rules" aria-labelledby="rules-title">
  <header class="rules-heading">
    <p class="eyebrow">Reglamento de competencia</p>
    <h2 id="rules-title">Cinco categorías.<br /><span>Un solo pulso.</span></h2>
    <p>Conocé los tiempos, requisitos y criterios que el jurado evaluará en cada desafío.</p>
  </header>

  <div class="rules-grid">
    {terms.categories.map((category) => (
      <article class="rule-card" aria-labelledby={`rule-category-${category.number}`}>
        <header class="rule-card__heading">
          <span class="rule-card__number" aria-hidden="true">{category.number}</span>
          <div>
            <h3 id={`rule-category-${category.number}`}>{category.name}</h3>
            <p class="rule-card__duration">
              <span aria-hidden="true">◷</span>
              <time datetime={category.datetime}>{category.duration}</time>
            </p>
          </div>
        </header>
        <ul>
          {category.rules.map((rule) => <li>{rule}</li>)}
        </ul>
      </article>
    ))}
  </div>
</section>
